@using DDON_WebPage.Components.Customs
@using DDON_WebPage.Components.Data
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using System.Text.Json

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ItemCatalogService ItemCatalog

<MudDialog>
    <DialogContent>
        <MudTabs Border>
            <MudTabPanel Text="Job Info">
                <MudGrid Class="my-3">
                    <MudItem Class="my-auto mx-auto" md="7">
                        <MudGrid Style="max-width: 700px">
                            @for (int jobId = 1; jobId <= 11; jobId++)
                            {
                                jobsById.TryGetValue(jobId, out var arisens);
                                var tooltip = _dicJobIds.GetValueOrDefault(arisens?.jobId ?? 0);

                                if(arisens != null)
                                {
                                    CharGrade grade;
                                    switch (arisens?.jobLevel)
                                    {
                                        case >= 0 and <= 25:
                                            grade = CharGrade.Bronze;
                                            break;

                                        case >= 26 and <= 50:
                                            grade = CharGrade.Silver;
                                            break;

                                        case >= 51 and <= 89:
                                            grade = CharGrade.Gold;
                                            break;

                                        case >= 90:
                                            grade = CharGrade.Platinum;
                                            break;

                                        default:
                                            grade = CharGrade.Bronze;
                                            break;
                                    }

                                    <MudItem Class="mx-auto">
                                        <MudTooltip Placement="Placement.Top" Text="@tooltip">
                                            <CustomMudAvatar BorderSize="63"
                                                             InnerSize="64"
                                                             BorderSrc="@($"./img/Icons/Jobs/icon_job_border_{grade}.png")"
                                                             InnerSrc="@($"./img/Icons/Jobs/icon_job_{(arisens?.jobId ?? 0)}.png")">
                                            </CustomMudAvatar>
                                        </MudTooltip>

                                        <MudText Class="py-1" Align="Align.Center" Typo="Typo.subtitle2">
                                            Level: @(arisens?.jobLevel ?? 0)
                                        </MudText>
                                    </MudItem>
                                }
                                else
                                {
                                    <MudItem Class="mx-auto">
                                        <MudTooltip Placement="Placement.Top" Text="@tooltip">
                                            <MudAvatar Size="Size.Large" Variant="Variant.Outlined">
                                                <MudImage Src="@($"./img/Icons/Jobs/icon_job_{(arisens?.jobId ?? 0)}.png")" />
                                            </MudAvatar>
                                        </MudTooltip>

                                        <MudText Class="py-3" Align="Align.Center" Typo="Typo.subtitle2">
                                            Level: @(arisens?.jobLevel ?? 0)
                                        </MudText>
                                    </MudItem>
                                }
                            }
                        </MudGrid>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Currency">
                <MudGrid Class="my-3">
                    @foreach (var wallet in listWallets.OrderBy(x => x.walletType))
                    {
                        <MudItem md="3">
                            <MudTextField ReadOnly Label="@_dicWalletTypes[wallet.walletType]" Variant="Variant.Text" Value="@wallet.walletValue" />
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Inventory">

                <MudGrid Class="my-auto mx-auto">
                    <MudItem>
                        <MudGrid Class="mx-auto" Style="max-width: 320px">
                            <MudItem Class="my-5 mx-auto" md="12">
                                <MudText Typo="Typo.h5" Align="Align.Center">Consumables</MudText>
                                <MudDivider />
                            </MudItem>
                            @foreach (var item in consumableItems)
                            {
                                <MudItem>
                                    <MudTooltip Text="@($"ID:{item.ItemId} - {item.Name}")">
                                        <CustomMudAvatar BorderSize="56" BorderSrc="./img/Icons/icon_inventory_slot.png" InnerSize="70" InnerSrc="@($"./item-image/ii{item.Icon.IconId.ToString("D6")}.png")" />
                                    </MudTooltip>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>
                    <MudItem>
                        <MudGrid Class="mx-auto" Style="max-width: 320px">
                            <MudItem Class="my-5 mx-auto" md="12">
                                <MudText Typo="Typo.h5" Align="Align.Center">Equipment</MudText>
                                <MudDivider />
                            </MudItem>
                            @foreach (var item in equipmentItems)
                            {
                                <MudItem>
                                    <MudTooltip Text="@($"{item.ItemId} - {item.Name}")">
                                        <CustomMudAvatar BorderSize="56" BorderSrc="./img/Icons/icon_inventory_slot.png" InnerSize="70" InnerSrc="@($"./item-image/ii{item.Icon.IconId.ToString("D6")}.png")" />
                                    </MudTooltip>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>
                </MudGrid>

            </MudTabPanel>
        
            <MudTabPanel Text="Skills">
                <MudGrid Class="my-auto mx-auto">
                    <MudItem Class="my-5 mx-auto" md="12">
                        <MudText Typo="Typo.h3" Align="Align.Center"> To Be Implemented</MudText>
                        <MudDivider />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        
            <MudTabPanel Text="Pawns">
                <MudGrid Class="my-auto mx-auto">
                    <MudItem Class="my-5 mx-auto" md="12">
                        <MudText Typo="Typo.h3" Align="Align.Center"> To Be Implemented</MudText>
                        <MudDivider />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton Class="pa-3" OnClick="Cancel" Color="Color.Default">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] 
    public int charId { get; set; }
    private CharGrade charGrade = 0;

    private List<vwCharactersJobData> listArisens = new();
    private List<WalletPoint> listWallets = new();
    private List<Item> listItems = new();

    private List<ItemJson> consumableItems = new();
    private List<ItemJson> equipmentItems = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCharInfo(charId);
    }

    private Dictionary<int, vwCharactersJobData> jobsById = new();

    Dictionary<int, string> _dicJobIds = new Dictionary<int, string>
    {
        { 0, "Unknown" },
        { 1, "Fighter" },
        { 2, "Seeker" },
        { 3, "Hunter" },
        { 4, "Priest" },
        { 5, "Shield Sage" },
        { 6, "Sorcerer" },
        { 7, "Warrior" },
        { 8, "Element Archer" },
        { 9, "Alchemist" },
        { 10, "Spirit Lancer" },
        { 11, "High Scepter" },

    };
    Dictionary<int, string> _dicWalletTypes = new Dictionary<int, string>
    {
        { 0, "Unknown" },
        { 1, "Gold" },
        { 2, "Rift Points" },
        { 3, "Blood Orbs" },
        { 4, "Silver Tickets" },
        { 5, "Golden Gemstones" },
        { 6, "Rental Points" },
        { 7, "Reset Job Points" },
        { 8, "Reset Craft Skills" },
        { 9, "High Orbs" },
        { 10, "Dominion Points" },
        { 11, "Adventure Pass Points" },
        { 12, "Custom-Made Service Tickets" },
        { 13, "Bitterblack Maze Reset Tickets" },
        { 14, "Golden Dragon Mark" },
        { 15, "Silver Dragon Mark" },
        { 16, "Red Dragon Mark" },

    };

    private async Task LoadCharInfo(int charId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        listArisens = await db.vw_characters_job_data
            .AsNoTracking()
            .Where(x => x.charId == charId)
            .ToListAsync();

        listWallets = await db.ddon_wallet_point
            .AsNoTracking()
            .Where(x => x.charId == charId)
            .OrderBy(x => x.walletType)
            .ToListAsync();

        listItems = await db.ddon_storage_item
            .AsNoTracking()
            .Where(x => x.charId == charId)
            .ToListAsync();

        jobsById = listArisens
            .GroupBy(x => x.jobId)
            .ToDictionary(x => x.Key, x => x.First());

        var uniqueItemIds = listItems
            .Select(x => x.itemId)
            .Distinct()
            .ToList();

        var itemJsonList = new List<ItemJson>();

        foreach (var itemId in uniqueItemIds)
        {
            var item = await ItemCatalog.GetItemAsync(itemId);

            if (item is not null)
                itemJsonList.Add(item);
        }

        consumableItems = itemJsonList
            .Where(x => x.Type == "consumable")
            .OrderBy(x => x.ItemId)
            .ToList();

        equipmentItems = itemJsonList
            .Where(x => x.Type == "equipment")
            .OrderBy(x => x.ItemId)
            .ToList();
    }

    void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog.Cancel();
}
