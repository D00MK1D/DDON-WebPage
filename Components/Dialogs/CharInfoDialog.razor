@using DDON_WebPage.Components.Data
@using Microsoft.EntityFrameworkCore
@using MudBlazor
@using System.Text.Json

@inject AppDbContext Pgsql
@inject IWebHostEnvironment Env

<MudDialog>
    <DialogContent>
        <MudTabs Border>
            <MudTabPanel Text="Job Info">
                @foreach (var arisens in listArisens.DistinctBy(x=> x.charId))
                {
                    <MudGrid Class="my-3">
                        <MudItem Class="mx-auto my-auto" md="3">
                            <MudImage Style="max-height:300px" ObjectFit="ObjectFit.Cover" Elevation="2" Src="@($"./img/Icons/Jobs/Heroes/hero_job_{(listArisens.MaxBy(x => x.jobLevel).jobId)}.png")" />
                        </MudItem>

                        <MudItem Class="my-auto mx-auto" md="6">
                            <MudGrid Style="max-width: 700px">
                                @for (int jobId = 1; jobId <= 11; jobId++)
                                {
                                    var arisens = listArisens.FirstOrDefault(x => x.jobId == jobId);
                                    var tooltip = _dicJobIds.GetValueOrDefault(arisens?.jobId ?? 0);

                                    <MudItem Class="mx-auto">
                                        <MudTooltip Placement="Placement.Top" Text="@tooltip">
                                            <MudAvatar Size="Size.Large" Variant="Variant.Outlined">
                                                <MudImage Src="@($"./img/Icons/Jobs/icon_job_{(arisens?.jobId ?? 0)}.png")" />
                                            </MudAvatar>
                                        </MudTooltip>

                                        <MudText Align="Align.Center" Typo="Typo.subtitle2">
                                            Level: @(arisens?.jobLevel ?? 0)
                                        </MudText>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                }
            </MudTabPanel>

            <MudTabPanel Text="Currency">
                <MudGrid Class="my-3">
                    @foreach (var wallet in listWallets.OrderBy(x => x.walletType))
                    {
                        <MudItem md="3">
                            <MudTextField AdornmentIcon="@Icons.Custom.Brands.MudBlazor" AdornmentColor="Color.Primary" ReadOnly Label="@_dicWalletTypes[wallet.walletType]" Variant="Variant.Text" Value="@wallet.walletValue" />
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <MudTabPanel Text="Equipment">

                <MudGrid Class="my-auto mx-auto " Style="max-width:700px;">
                    @foreach (var item in listItemsJson.DistinctBy(x=> x.ItemId))
                    {
                        <MudItem>
                            <MudTooltip Text="@($"{item.ItemId} - {item.Name}")" >
                                <MudAvatar Size="Size.Large" Rounded Style="background-color: rgb(181, 177, 148);" Color="Color.Primary" Square Variant="Variant.Outlined">
                                    <MudImage Src="@($"./img/Icons/Items/ii{item.Icon.IconId.ToString("D6")}.png")" />
                                </MudAvatar>
                            </MudTooltip>
                        </MudItem>
                    }
                </MudGrid>

            </MudTabPanel>
        
            <MudTabPanel Text="Skills">
                <MudGrid>
                    <MudItem Class="my-5 mx-auto" md="12">
                        <MudText Typo="Typo.h3" Align="Align.Center"> To Be Implemented</MudText>
                        <MudDivider />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        
            <MudTabPanel Text="Pawns">
                <MudGrid>
                    <MudItem Class="my-5 mx-auto" md="12">
                        <MudText Typo="Typo.h3" Align="Align.Center"> To Be Implemented</MudText>
                        <MudDivider />
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>

    <DialogActions>
        <MudButton Class="pa-3" OnClick="Cancel" Color="Color.Default">Cancel</MudButton>
        <MudButton Class="pa-3" OnClick="Confirm" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] 
    public int charId { get; set; }

    private List<vwCharactersJobData> listArisens = new();
    private List<WalletPoint> listWallets = new();
    private List<Item> listItems = new();
    private List<ItemJson> listItemsJson = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCharInfo(charId);
    }

    Dictionary<int, string> _dicJobIds = new Dictionary<int, string>
    {
        { 0, "Unknown" },
        { 1, "Fighter" },
        { 2, "Seeker" },
        { 3, "Hunter" },
        { 4, "Priest" },
        { 5, "Shield Sage" },
        { 6, "Sorcerer" },
        { 7, "Warrior" },
        { 8, "Element Archer" },
        { 9, "Alchemist" },
        { 10, "Spirit Lancer" },
        { 11, "High Scepter" },

    };
    Dictionary<int, string> _dicWalletTypes = new Dictionary<int, string>
    {
        { 0, "Unknown" },
        { 1, "Gold" },
        { 2, "Rift Points" },
        { 3, "Blood Orbs" },
        { 4, "Silver Tickets" },
        { 5, "Golden Gemstones" },
        { 6, "Rental Points" },
        { 7, "Reset Job Points" },
        { 8, "Reset Craft Skills" },
        { 9, "High Orbs" },
        { 10, "Dominion Points" },
        { 11, "Adventure Pass Points" },
        { 12, "Custom-Made Service Tickets" },
        { 13, "Bitterblack Maze Reset Tickets" },
        { 14, "Golden Dragon Mark" },
        { 15, "Silver Dragon Mark" },
        { 16, "Red Dragon Mark" },

    };

    private async Task LoadCharInfo(int charId)
    {
        listArisens = await Pgsql.vw_characters_job_data.AsNoTracking().Where(x=> x.charId == charId).ToListAsync();
        listWallets = await Pgsql.ddon_wallet_point.AsNoTracking().Where(x => x.charId == charId).ToListAsync();
        listItems = await Pgsql.ddon_storage_item.AsNoTracking().Where(x => x.charId == charId).ToListAsync();

        foreach (var id in listItems)
        {
            var path = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "items", $"i{id.itemId:D8}.json");
            if (!File.Exists(path))
                continue;

            var json = await File.ReadAllTextAsync(path);
            var item = JsonSerializer.Deserialize<ItemJson>(json);

            if (item != null)
                listItemsJson.Add(item);
        }
        
    }

    void Confirm() => MudDialog.Close(DialogResult.Ok(true));
    void Cancel() => MudDialog.Cancel();
}
