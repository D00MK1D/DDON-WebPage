    <MudNavLink Target="_blank" Href="https://reference.dd-on.com/build/01_hidell_plains.html" Icon="@Icons.Material.Filled.Public">World Quests</MudNavLink>
    <MudNavLink Target="_blank" Href="https://reference.dd-on.com/build/useful_for_adventure.html" Icon="@Icons.Material.Filled.Article">Personal Quests</MudNavLink>
    <MudNavLink Target="_blank" Href="https://reference.dd-on.com/build/items_accessory.html" Icon="@Icons.Material.Filled.Shield">Items</MudNavLink>
    <MudNavLink class="NavLink" Href="" OnClick="AuthProvider.MarkUserAsLoggedOut" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Logout">Logout</MudNavLink>
</MudNavMenu>

