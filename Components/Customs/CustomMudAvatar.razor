<style>
    .avatar-wrapper {
        position: relative;
        display: inline-block;
    }

    .avatar-border {
        width: 100%;
        height: 100%;
        display: block;
    }

    .avatar-inner {
        position: absolute;
        top: 50%;
        left: 51%;
        transform: translate(-50%, -50%);
    }
</style>
<div class="avatar-wrapper" style="@WrapperStyle">
    <MudImage Src="@BorderSrc" Class="avatar-border" />

    <MudImage Src="@InnerSrc" Class="avatar-inner" Style="@InnerStyle" />
</div>

@code {
    [Parameter] public string BorderSrc { get; set; } = string.Empty;
    [Parameter] public string InnerSrc { get; set; } = string.Empty;

    [Parameter] public int BorderSize { get; set; }
    [Parameter] public int InnerSize { get; set; }

    private string WrapperStyle => $"width:{BorderSize}px; height:{BorderSize}px;";
    private string InnerStyle => $"width:{InnerSize}px; height:{InnerSize}px;";
}