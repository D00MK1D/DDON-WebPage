@page "/"
@using DDON_WebPage.Components.Data
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ISnackbar Snackbar

<PageTitle>Dragon's Dogma Online</PageTitle>

<MudGrid>
    <MudItem Class="mx-auto">
        <MudPaper Class=" pa-15">
            <MudText Color="Color.Primary" Align="Align.Center" Typo="Typo.h4"><b>Arisens</b></MudText>
            <MudText Color="Color.Primary" Align="Align.Center" Typo="Typo.h5">@(onlinePlayers.Count.ToString("D3")) / @(totalPlayers.ToString("D3"))</MudText>
            <MudText Color="Color.Primary" Align="Align.Center"> Active / Total</MudText>
        </MudPaper>
    </MudItem>

    <MudItem Class="mx-auto">
        <MudTable Items="onlinePlayers" Style="width:80vh" Hover>
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Logged For</MudTh>
                <MudTh>Status</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Name">@context.AccountName</MudTd>
                <MudTd DataLabel="Logged For">@((DateTime.UtcNow - context.ConnectedAt).ToString(@"hh\:mm"))</MudTd>
                <MudTd DataLabel="">@(context.ServerId == 1 ? "Logging in" : "Game Server")</MudTd>
            </RowTemplate>

            <PagerContent>
                <MudTablePager PageSizeOptions="[3, 5]"/>
            </PagerContent>
        </MudTable>
    </MudItem>
    
    <MudItem>
    </MudItem>

    <MudItem>
    </MudItem>
</MudGrid>

@code {
    private List<Connection>? onlinePlayers = new();
    private int totalPlayers;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        onlinePlayers = await db.connection
        .FromSqlRaw(@"SELECT conn.server_id, acc.Name as account_name, conn.created as connected_at 
                        FROM ddon_connection conn 
                        JOIN account acc on conn.account_id = acc.id;").AsNoTracking().ToListAsync();

        totalPlayers = await db.account
        .AsNoTracking()
        .CountAsync();

    }
}