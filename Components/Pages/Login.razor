@using DDON_WebPage.Components.Data
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<AppDbContext> DbFactory
@inject ServerApiClient ServerApi
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar

@page "/Login"


<PageTitle>Dragon's Dogma Online</PageTitle>

<MudPaper Class="pa-6 mx-auto my-auto" Style="max-width:430px;">
    <MudImage Class="mx-auto my-3 d-flex" Height="200" Src="./img/Logos/Logo_Y1.png" ObjectFit="ObjectFit.Contain"/>
    
    <MudDivider />

    <MudTextField Class="my-3" @bind-Value="account" Label="Account ID" Variant="Variant.Outlined" MaxLength="50" />

    <MudTextField @bind-Value="password" Label="Password" 
                  Variant="Variant.Outlined" InputType="@PasswordInput" 
                  Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" 
                  OnAdornmentClick="@ShowPassword" AdornmentAriaLabel="Show Password" 
                  MaxLength="50"/>
    
    <MudButton ButtonType="ButtonType.Submit" Class="my-6" 
               OnClick="LoginTask" Disabled="_loadingState" 
               FullWidth="true" Color="Color.Primary" 
               Variant="Variant.Filled">
        @if (_loadingState)
        {
            <MudProgressCircular Color="Color.Primary" Rounded="true" Size="Size.Small" Indeterminate="true" />
        }
        else
        {
            <MudText Color="Color.Dark" Typo="Typo.button"><b>Login</b></MudText>
        }
    </MudButton>
    
    <a href="/ForgotPassword"> <MudText Align="Align.Center" Color="Color.Primary">Forgot My Password...</MudText> </a>
</MudPaper>
<br />

@code {
    private string account = string.Empty;
    private string password = string.Empty;
    private bool _loadingState;

    private bool isShow;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private InputType PasswordInput = InputType.Password;

    private async Task LoginTask()
    {
        if (_loadingState)
            return;

        var accountInput = account?.Trim() ?? string.Empty;
        var passwordInput = password ?? string.Empty;

        if (string.IsNullOrWhiteSpace(accountInput) || string.IsNullOrWhiteSpace(passwordInput))
        {
            Snackbar.Add("Account and password cannot be empty.", Severity.Warning);
            return;
        }

        if (accountInput.Length > 50 || passwordInput.Length > 50)
        {
            Snackbar.Add("Account and password must contain less than 50 characters.", Severity.Warning);
            return;
        }

        _loadingState = true;

        try
        {
            var response = await ServerApi.OperationAsync(
                ServerApiClient.AccountAction.Login,
                account: accountInput,
                password: passwordInput);

            if (!string.IsNullOrWhiteSpace(response.Error))
            {
                Console.WriteLine($"\n{DateTime.UtcNow} - Error: {response.Error} - Account: {accountInput}\n");
                Snackbar.Add(response.Error, Severity.Warning);
                return;
            }

            if (string.IsNullOrWhiteSpace(response.Token))
            {
                var message = string.IsNullOrWhiteSpace(response.Message)
                    ? "Invalid server response."
                    : response.Message;

                Snackbar.Add(message, Severity.Warning);
                return;
            }

            await using var db = await DbFactory.CreateDbContextAsync();

            var normalizedAccount = accountInput.ToLowerInvariant();

            var user = await db.account
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.NormalName == normalizedAccount);

            if (user is null)
            {
                Snackbar.Add("Invalid user or password.", Severity.Warning);
                return;
            }

            switch (user.State)
            {
                case 100:
                case 50:
                case 1:
                    AuthProvider.MarkUserAsAuthenticated(user.Name, user.Id);
                    Snackbar.Add($"Welcome {user.Name}!", Severity.Info);
                    Navigation.NavigateTo("/Player");
                    return;

                case 0:
                    Snackbar.Add($"The {user.Name} account has been banned.", Severity.Warning);
                    return;

                default:
                    Snackbar.Add("Invalid account state not identified.", Severity.Warning);
                    return;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"\n{DateTime.UtcNow} - Login exception: {ex}\n");
            Snackbar.Add("There was an error processing your request.", Severity.Error);
        }
        finally
        {
            _loadingState = false;
        }
    }

    private void ShowPassword()
    {
        if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
}