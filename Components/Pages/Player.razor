@attribute [Authorize]
@using DDON_WebPage.Components.Data
@using DDON_WebPage.Components.Dialogs
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using static DDON_WebPage.Components.Data.Models

@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ServerApiClient ServerApi

@page "/Player"

<PageTitle>DDON - Player Page</PageTitle>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pa-2">
    <MudTabPanel Text="Account">
        <MudPaper Class="pa-6 my-4 mx-auto" Style="max-width:600px;">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4">@UserName's Account Info</MudText>

            <br />
            <MudDivider />
            <br />
            <br />

            <MudForm @ref="form" Model="updateModel" OnValidSubmit="HandleValidSubmit">
                <MudGrid>
                    <MudItem xs="5">
                        <MudTextField T="string" Label="New Password"
                                      @bind-Value="updateModel.Password"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Disabled="@(!_enableEditPassword)"
                                      InputType="@PasswordInput"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@PasswordInputIcon"
                                      OnAdornmentClick="@ShowPassword"
                                      AdornmentAriaLabel="Show Password" />
                    </MudItem>

                    <MudItem xs="5">
                        <MudTextField T="string" Label="Confirm Password"
                                      @bind-Value="updateModel.ConfirmPassword"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      Disabled="@(!_enableEditPassword)"
                                      InputType="@PasswordInput"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@PasswordInputIcon"
                                      OnAdornmentClick="@ShowPassword"
                                      AdornmentAriaLabel="Show Password"
                                      For="@(() => updateModel.ConfirmPassword)" />
                    </MudItem>

                    <MudItem Class="d-flex align-center" xs="2">
                        <MudIconButton OnClick="EditPassword" Icon="@_iconEditPassword" />
                    </MudItem>

                    <MudItem xs="10">
                        <MudTextField Disabled="@(!_enableEditMail)"
                                      T="string" Label="Email"
                                      @bind-Value="updateModel.Email"
                                      Variant="Variant.Outlined"
                                      Immediate="true"
                                      For="@(() => updateModel.Email)" />
                    </MudItem>

                    <MudItem xs="2" Class="d-flex align-center">
                        <MudIconButton OnClick="EditMail" Icon="@_iconEditMail" />
                    </MudItem>

                    <MudItem Class="d-flex" Style="align-items: center" xs="4">
                        @if (player.EmailVerified)
                        {
                            <MudIcon Class="px-1" Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle" />
                            <MudText Color="Color.Success"><b> Mail Verified</b></MudText>
                        }
                        else
                        {
                            <MudIcon Class="px-1" Color="Color.Error" Icon="@Icons.Material.Filled.AddCircle" Style="transform: rotate(45deg)" />
                            <MudText Color="Color.Error"><b> Mail Not Verified</b></MudText>
                        }
                    </MudItem>

                    <MudItem xs="7" />
                    
                    <MudItem>
                        <MudButton Color="Color.Primary" Disabled="@(!_enableEditPassword && !_enableEditMail)" Variant="Variant.Filled" OnClick="SaveChanges">
                            @if (_loadingState)
                            {
                                <MudProgressCircular Color="Color.Primary" Rounded="true" Size="Size.Medium" Indeterminate="true" />
                            }
                            else
                            {
                                <MudText Color="Color.Dark" Typo="Typo.button"><b>Save</b></MudText>
                            }
                        </MudButton>
                    </MudItem>

                    <MudItem>
                        <MudButton Color="Color.Transparent" Disabled="@(!_enableEditPassword && !_enableEditMail)" Variant="Variant.Filled" OnClick="CancelEdits"><MudText Color="Color.Dark" Typo="Typo.button"><b>Cancel</b></MudText></MudButton>
                    </MudItem>

                </MudGrid>

            </MudForm>

            <br />
            <MudDivider />
            <br />

            <MudItem>
                <MudTextField T="DateTime" @bind-Value="@player.CreatedAt" Disabled Variant="Variant.Outlined" Label="Member Since:" />
            </MudItem>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Arisen">

        @foreach (var charGroup in listArisens.Where(x => x.playerId == player.Id).GroupBy(x => x.charId))
        {
            var arisen = charGroup.First();
            var mainJob = charGroup.MaxBy(x => x.jobLevel);

            <MudButton OnClick="@(()=> DialogCharInfo(arisen.charId))">
                <MudCard Class="pa-2 my-4 mx-auto" Style="max-width: 300px;">

                    <MudCardMedia Image="@($"./img/icons/Jobs/Heroes/hero_job_{mainJob.jobId}.png")" Height="320" />

                    <MudCardContent Class="d-flex">

                        <MudTooltip Placement="Placement.Top" Text="@_dicJobIds[mainJob.jobId]">
                            <MudAvatar Size="Size.Large" Variant="Variant.Outlined">
                                <MudImage Src="@($"./img/icons/Jobs/icon_job_{mainJob.jobId}.png")" />
                            </MudAvatar>
                        </MudTooltip>

                        <div class="mx-3">
                            <MudText Typo="Typo.body1">
                                @arisen.charFirstName @arisen.charLastName
                            </MudText>

                            <MudText Typo="Typo.body2">
                                Main Job: @_dicJobIds[mainJob.jobId] <br />
                                Level: @mainJob.jobLevel
                            </MudText>
                        </div>

                    </MudCardContent>

                    <MudCardActions>
                    </MudCardActions>

                </MudCard>
            </MudButton>
        }

    </MudTabPanel>

    @if (player.State is 100 or 50)
    {
        <MudTabPanel Text="Player Management">
            <MudTable Dense Class="pa-2 my-4" T="Account" Items="listAccounts" Hover="true" Filter="FilterAccounts">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Accounts</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchAccountString" Placeholder="Search by name" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="@((Account a) => a.Name)">Name</MudTableSortLabel></MudTh>
                    <MudTh>Characters</MudTh>
                    <MudTh><MudTableSortLabel SortBy="@((Account a) => a.CreatedAt)">Created At</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="@((Account a) => a.LastLogin)">Last Login</MudTableSortLabel></MudTh>
                    <MudTh>State</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>@context.Name</MudTd>
                    <MudTd>@(characterCountByAccountId.TryGetValue(context.Id, out var count) ? count : 0)</MudTd>
                    <MudTd>@context.CreatedAt</MudTd>
                    <MudTd>@context.LastLogin</MudTd>
                    <MudTd>@(_dicStateIds[context.State])</MudTd>
                    <MudTd>

                        @if(context.State != 0)
                        {
                            <MudIconButton OnClick="@(() => ApplyBan(context))"
                                           Disabled="@(context.State == 0 || player.State == context.State)"
                                           Icon="@(!loadingIds.Contains(context.Id) ? Icons.Material.Filled.Gavel : null)"
                                           Color="Color.Error"
                                           Title="Ban">
                                @if (loadingIds.Contains(context.Id))
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Error" />
                                }
                            </MudIconButton>
                        }
                        else
                        {
                            <MudIconButton OnClick="@(() => RemoveBan(context))"
                                           Disabled="@(context.State != 0)"
                                           Icon="@(!loadingIds.Contains(context.Id) ? Icons.Material.Filled.LockOpen : null)"
                                           Color="Color.Success"
                                           Title="Unban">
                                @if (loadingIds.Contains(context.Id))
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Success" />
                                }
                            </MudIconButton>
                        }

                    </MudTd>
                </RowTemplate>

                <PagerContent>
                    <MudTablePager PageSizeOptions="[5, 10, 20, 50, 100]"/>
                </PagerContent>
            </MudTable>
        </MudTabPanel>
    }
</MudTabs>


    @code {
    #region Variables
    private bool isShow = false;
    private bool _loadingState = false;
    private bool _enableEditMail = false;
    private bool _enableEditPassword = false;
    private string? PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    private string? UserName;
    private string? _iconEditMail = Icons.Material.Filled.Edit;
    private string? _iconEditPassword = Icons.Material.Filled.Edit;
    private string oldEmail = "";
    private string searchAccountString = "";
    #endregion

    #region Models
    private HashSet<int> loadingIds = new();
    private List<Account> listAccounts = new();
    private List<vwCharactersJobData> listArisens = new();
    private Dictionary<int, int> characterCountByAccountId = new();
    private MudForm form = new();
    private Account? player = new();
    private UpdateModel updateModel = new();
    private ServerApiClient.ServerResponse? serverResponse = new();
    private InputType PasswordInput = InputType.Password;
    #endregion

    #region All Users
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not { IsAuthenticated: true } || string.IsNullOrWhiteSpace(user.Identity.Name))
            return;

        UserName = user.Identity.Name;

        await using var db = await DbFactory.CreateDbContextAsync();

        player = await db.account
            .FirstOrDefaultAsync(u => u.NormalName == UserName.ToLower());

        if (player is null)
        {
            Snackbar.Add("Account not found.", Severity.Error);
            return;
        }

        updateModel.Email = player.Email;
        oldEmail = player.Email;

        await LoadCharInfo(player.Id);

        if (player.State is 100 or 50)
        {
            await RefreshAccounts();
            await LoadCharacterCountsByAccountId();
        }
    }

    private async Task SaveChanges()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        isLoadingToggle();
        if (player != null && form.IsValid)
        {
            if ((string.IsNullOrWhiteSpace(oldEmail) || oldEmail.EndsWith("@dd.on")) && player.Email.EndsWith("@dd.on"))
            {
                Snackbar.Add(new MarkupString("You're trying to use default old generated e-mail. <br />Change it first to a real valid one!"), Severity.Warning);
                return;
            }
            else if (!string.IsNullOrWhiteSpace(updateModel.Email) && updateModel.Email != oldEmail)
            {
                var account = await db.account.FirstOrDefaultAsync(x => x.Id == player.Id);

                if (account is null)
                {
                    Snackbar.Add("Account not found.", Severity.Error);
                    return;
                }

                account.Email = updateModel.Email;
                await db.SaveChangesAsync();

                player.Email = account.Email;
                oldEmail = account.Email;

                Snackbar.Add("Your e-mail has been updated.", Severity.Success);
            }

            if (!string.IsNullOrWhiteSpace(updateModel.Password) && !string.IsNullOrWhiteSpace(updateModel.ConfirmPassword) && updateModel.Password == updateModel.ConfirmPassword && _enableEditPassword)
            {
                try
                {
                    serverResponse = await ServerApi.OperationAsync(ServerApiClient.AccountAction.ForgotPassword, email: oldEmail);

                    if (serverResponse.Error is null)
                    {
                        player = await db.account.AsNoTracking().FirstOrDefaultAsync(u => u.NormalName == UserName.ToLower());
                        serverResponse = await ServerApi.OperationAsync(ServerApiClient.AccountAction.ResetPassword, account: player.Name, password: updateModel.ConfirmPassword, passwordToken: player.PasswordToken);

                        if (serverResponse.Error is null)
                        {
                            Snackbar.Add("Your password has been updated.", Severity.Success);
                        }
                        else
                        {
                            Snackbar.Add(serverResponse.Error, Severity.Warning);
                        }
                    }
                }
                catch
                {
                    Snackbar.Add("Something went wrong, try again.", Severity.Error);
                }
            }
        }
        isLoadingToggle();
    }

    private void EditMail()
    {
        if (_enableEditMail)
        {
            _iconEditMail = Icons.Material.Filled.Edit;
            updateModel.Email = oldEmail;
        }
        else
        {
            _iconEditMail = Icons.Material.Filled.Close;
        }

        _enableEditMail = !_enableEditMail;
    }

    private void EditPassword()
    {
        if (_enableEditPassword)
        {
            _iconEditPassword = Icons.Material.Filled.Edit;
            updateModel.Password = "";
            updateModel.ConfirmPassword = "";
        }
        else
        {
            _iconEditPassword = Icons.Material.Filled.Close;
        }

        _enableEditPassword = !_enableEditPassword;
    }

    private void CancelEdits()
    {
        if (_enableEditMail)
            EditMail();

        if (_enableEditPassword)
            EditPassword();
    }

    void ShowPassword()
    {
        isShow = !isShow;
        PasswordInputIcon = isShow ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
        PasswordInput = isShow ? InputType.Text : InputType.Password;
    }

    private async Task DialogCharInfo(int charId)
    {
        var parameters = new DialogParameters<CharInfoDialog> { { x => x.charId, charId } };
        var dialog = await DialogService.ShowAsync<CharInfoDialog>("", parameters);
        var result = await dialog.Result;
    }
    #endregion

    #region Admin Users
    private async Task LoadCharInfo(int playerId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        listArisens = await db.vw_characters_job_data
            .AsNoTracking()
            .Where(x => x.playerId == playerId)
            .ToListAsync();
    }

    private async Task ApplyBan(Account account)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        DialogParameters parameters = new DialogParameters { ["Message"] = $"Are you sure you want to ban '{account.NormalName}'?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Ban", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            loadingIds.Add(account.Id);
            StateHasChanged();

            var acc = await db.account.FirstOrDefaultAsync(a => a.Id == account.Id);
            if (acc is not null)
            {
                acc.State = 0;
                await db.SaveChangesAsync();
                Snackbar.Add($"{acc.Name} has been banned.", Severity.Warning);
            }

            loadingIds.Remove(account.Id);
            if (player.State is 100 or 50)
            {
                await RefreshAccounts();
            }
        }
    }

    private async Task RemoveBan(Account account)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var parameters = new DialogParameters { ["Message"] = $"Are you sure you want to unban '{account.NormalName}'?" };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Unban", parameters);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            loadingIds.Add(account.Id);
            StateHasChanged();

            var acc = await db.account.FirstOrDefaultAsync(a => a.Id == account.Id);
            if (acc is not null)
            {
                acc.State = 1;
                await db.SaveChangesAsync();
                Snackbar.Add($"{acc.Name} has been unbanned.", Severity.Success);
            }

            loadingIds.Remove(account.Id);
            if (player.State is 100 or 50)
            {
                await RefreshAccounts();
            }
        }
    }

    private bool FilterAccounts(Account account)
    {
        if (string.IsNullOrEmpty(searchAccountString)) return true;
        return account.Name?.Contains(searchAccountString, StringComparison.OrdinalIgnoreCase) == true;
    }

    private async Task RefreshAccounts()
    {
        if (player.State is not 50 and not 100)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        listAccounts = await db.account
            .AsNoTracking()
            .OrderBy(x => x.Name)
            .ToListAsync();
    }

    private async Task LoadCharacterCountsByAccountId()
    {
        if (player.State is not 50 and not 100)
            return;

        await using var db = await DbFactory.CreateDbContextAsync();

        characterCountByAccountId = await db.vw_characters_job_data
            .AsNoTracking()
            .Select(x => new { x.playerId, x.charId })
            .Distinct()
            .GroupBy(x => x.playerId)
            .Select(g => new
            {
                PlayerId = g.Key,
                Count = g.Count()
            })
            .ToDictionaryAsync(x => x.PlayerId, x => x.Count);
    }
    #endregion
    
    private void isLoadingToggle()
    {
        _loadingState = !_loadingState;
    }

    Dictionary<int, string> _dicJobIds = new Dictionary<int, string>
    {
        { 0, "None" },
        { 1, "Fighter" },
        { 2, "Seeker" },
        { 3, "Hunter" },
        { 4, "Priest" },
        { 5, "Shield Sage" },
        { 6, "Sorcerer" },
        { 7, "Warrior" },
        { 8, "Element Archer" },
        { 9, "Alchemist" },
        { 10, "Spirit Lancer" },
        { 11, "High Scepter" },

    };

    Dictionary<int, string> _dicStateIds = new Dictionary<int, string>
    {
        { 0, "Banned" },
        { 1, "Player" },
        { 50, "Game Master" },
        { 100, "Administrator" }
    };
}